{
  "info": {
    "name": "Enterprise Document Intelligence Platform API",
    "description": "Postman collection for Auth, Document Management, Conversations, Grounded RAG, Dashboard, and Admin APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" },
    { "key": "documentId", "value": "" },
    { "key": "conversationId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Athul Engineer\",\n  \"email\": \"athul@enterprise.com\",\n  \"password\": \"StrongPassword123!\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"athul@enterprise.com\",\n  \"password\": \"StrongPassword123!\"\n}"
            }
          }
        },
        {
          "name": "Current User (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload Single Document",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/documents/upload",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "" }]
            }
          }
        },
        {
          "name": "Upload Multiple Documents",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/documents/upload-multiple",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "files", "type": "file", "src": "" }]
            }
          }
        },
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/documents?page=0&size=20"
          }
        },
        {
          "name": "Get Document Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/documents/{{documentId}}"
          }
        },
        {
          "name": "Get Document Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/documents/{{documentId}}/status"
          }
        },
        {
          "name": "Reprocess Document",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/documents/{{documentId}}/reprocess"
          }
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/documents/{{documentId}}"
          }
        }
      ]
    },
    {
      "name": "RAG & Conversations",
      "item": [
        {
          "name": "Ask RAG (Auto or Existing Conversation)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/rag/ask",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is the company annual leave policy?\",\n  \"documentId\": null,\n  \"topK\": 6,\n  \"similarityThreshold\": 0.55,\n  \"temperature\": 0.2\n}"
            }
          }
        },
        {
          "name": "Create Conversation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/conversations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"HR Policy Q&A\",\n  \"documentId\": null\n}"
            }
          }
        },
        {
          "name": "List Conversations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/conversations?page=0&size=20"
          }
        },
        {
          "name": "Chat in Conversation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/conversations/{{conversationId}}/chat",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Can unused days be carried over?\"\n}"
            }
          }
        },
        {
          "name": "Get Conversation Messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/conversations/{{conversationId}}/messages?page=0&size=50"
          }
        },
        {
          "name": "Rename Conversation",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/conversations/{{conversationId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Renamed Conversation\"\n}"
            }
          }
        },
        {
          "name": "Delete Conversation",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/conversations/{{conversationId}}"
          }
        }
      ]
    },
    {
      "name": "Dashboard & Admin",
      "item": [
        {
          "name": "User Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/dashboard/summary"
          }
        },
        {
          "name": "Admin Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/admin/dashboard"
          }
        },
        {
          "name": "Admin List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/admin/users?page=0&size=20"
          }
        },
        {
          "name": "Admin AI Usage Audit Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/admin/ai-usage?page=0&size=20"
          }
        }
      ]
    }
  ]
}
