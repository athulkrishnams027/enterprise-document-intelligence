# ==============================================================================
# Enterprise Document Intelligence Platform - Environment Configuration
# Copy this file to .env and customize for your environment.
# ==============================================================================

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_DB=document_intelligence
POSTGRES_USER=docintel
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_PORT=5433

# --- Backend Application ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- JWT Security (Base64 or >=32-byte secret; MUST be overridden in production) ---
JWT_SECRET=ZGV2LW9ubHktY2hhbmdlLW1lLWluLXByb2R1Y3Rpb24tNjQtYnl0ZS1zZWNyZXQta2V5LTIwMjY=
JWT_EXPIRATION_MS=86400000

# --- Document Storage ---
APP_STORAGE_ROOT=./storage
APP_MAX_UPLOAD_SIZE=50MB

# --- AI Provider Selection (ollama | openai | google-genai) ---
AI_CHAT_PROVIDER=ollama
AI_EMBEDDING_PROVIDER=ollama

# --- Ollama Configuration ---
# OLLAMA_BASE_URL is used when running backend on host; DOCKER_OLLAMA_BASE_URL is used inside Docker Compose
OLLAMA_BASE_URL=http://localhost:11434
DOCKER_OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_PORT=11434

# --- OpenAI Configuration (Optional - required only if AI_*_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Google Gemini Configuration (Optional - required only if AI_*_PROVIDER=google-genai) ---
GOOGLE_GENAI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Vector Store & RAG Tuning ---
VECTOR_DIMENSIONS=768
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.55
RAG_MAX_CONTEXT_CHARS=12000
RAG_TEMPERATURE=0.2
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=150

# --- CORS & Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_PORT=3000
